<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de backup (auditoria M4). Fora do backup ficam:
  - TODAS as bases Room (database): a fila offline guarda PINs de cliente
    e a base de rastreio guarda o histórico de posição do motoboy;
  - TODAS as SharedPreferences (sharedpref): sessão do Supabase, presença,
    acesso biométrico e o cache de endereços geocodificados de clientes.
  O restante (ex.: preferências DataStore, não sensíveis) segue o padrão.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>

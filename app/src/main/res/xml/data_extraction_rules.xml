<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de extração (API 31+, auditoria M4): as mesmas exclusões do
  backup_rules.xml valem para o backup em nuvem E para a transferência
  aparelho-a-aparelho — sessão do Supabase, PINs da fila offline, base de
  rastreio e cache de endereços nunca saem do aparelho.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
